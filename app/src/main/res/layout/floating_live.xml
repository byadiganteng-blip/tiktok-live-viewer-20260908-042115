<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="8dp"
    android:background="#CC000000">
    <TextView android:id="@+id/tvTitle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Live" android:textColor="#FE2C55"
        android:textSize="14sp" android:textStyle="bold"/>
    <TextView android:id="@+id/tvComments"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:textColor="#FFF" android:textSize="10sp"/>
</LinearLayout>