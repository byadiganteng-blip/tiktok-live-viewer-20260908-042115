<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp" android:gravity="center"
    android:background="#0f0f1a">
    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="TikTok Live Viewer" android:textSize="24sp"
        android:textColor="#FE2C55" android:textStyle="bold"
        android:layout_marginBottom="20dp"/>
    <EditText
        android:id="@+id/etUsername"
        android:layout_width="match_parent" android:layout_height="50dp"
        android:hint="Username TikTok" android:padding="10dp"
        android:textColor="#FFF" android:background="#1a1a2e"
        android:layout_marginBottom="15dp"/>
    <EditText
        android:id="@+id/etServerUrl"
        android:layout_width="match_parent" android:layout_height="50dp"
        android:hint="Server URL" android:padding="10dp"
        android:textColor="#FFF" android:background="#1a1a2e"
        android:layout_marginBottom="25dp"/>
    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent" android:layout_height="50dp"
        android:text="Start Floating" android:background="#FE2C55"/>
</LinearLayout>